{
	"name": "@graphmind/cli",
	"version": "0.1.9",
	"description": "Your codebase has memory. Use it.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aouicher/graphmind.git"
	},
	"keywords": [
		"claude-code",
		"mcp",
		"code-intelligence",
		"knowledge-graph",
		"tree-sitter",
		"local-first"
	],
	"type": "module",
	"bin": {
		"graphmind": "./dist/cli/index.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": ["dist", "src/native", "src/skill/SKILL.md"],
	"scripts": {
		"build": "tsup",
		"build:rust": "cd crates/graphmind-core && napi build --release --platform",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.12.1",
		"better-sqlite3": "^11.7.0",
		"chalk": "^5.4.1",
		"chokidar": "^4.0.3",
		"commander": "^13.1.0",
		"uuid": "^11.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@napi-rs/cli": "^3.6.2",
		"@types/better-sqlite3": "^7.6.12",
		"@types/node": "^22.12.0",
		"@types/uuid": "^10.0.0",
		"tsup": "^8.3.6",
		"typescript": "^5.7.3",
		"vitest": "^3.0.4"
	},
	"optionalDependencies": {
		"@xenova/transformers": "^2.17.2"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
