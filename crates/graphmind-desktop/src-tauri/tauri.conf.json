{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/dev/core/tauri-config-schema/schema.json",
  "productName": "GraphMind",
  "version": "0.2.112",
  "identifier": "com.graphmind.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GraphMind",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 500,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "transparent": false,
        "resizable": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": { "x": 170, "y": 150 },
        "applicationFolderPosition": { "x": 430, "y": 150 },
        "windowSize": { "width": 600, "height": 340 }
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "Local-first code intelligence",
    "longDescription": "GraphMind gives AI coding tools structural understanding of your codebase via MCP. Manage projects, index code, and install integrations from one app."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/aouicher/graphmind-dist/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyMEMxMTI5Q0I5NTVGRkQKUldUOVg1WExLUkVNSWc3aEtLT2ZXcDNOUTZDMCtTVXovZHBkZTRGRTFFY1lFL1NHRXJ3V2M1eUoK"
    }
  }
}
